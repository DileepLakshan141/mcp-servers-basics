{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["handler.ts", "server.ts"]
}
